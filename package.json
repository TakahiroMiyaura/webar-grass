{
  "name": "webar-grass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Smartphone WebAR: tap a surface and grass grows there. Self-hosted 8th Wall Engine + three.js, published on GitHub Pages.",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/sync-vendor.mjs",
    "predev": "node scripts/sync-vendor.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-vendor.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "qr": "node tools/make-qr.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:placement": "node scripts/verify-placement.mjs",
    "verify:placement-preview": "node scripts/verify-placement-preview.mjs",
    "test:placement": "node scripts/test-placement.mjs",
    "verify:tracking-ux": "node scripts/verify-tracking-ux.mjs",
    "verify:inapp": "node scripts/verify-inapp.mjs",
    "verify:camera-fov": "node scripts/verify-camera-fov.mjs",
    "verify:qr": "node tools/verify-qr.mjs",
    "assets": "node tools/make-textures.mjs && node tools/make-grass-glb.mjs",
    "assets:verify": "node tools/verify-geometry.mjs",
    "assets:compress": "node tools/compress.mjs",
    "bench": "npm run build && node tools/bench.mjs"
  },
  "dependencies": {
    "@8thwall/coaching-overlay": "1.0.0",
    "@8thwall/engine-binary": "1.0.0",
    "@8thwall/landing-page": "1.0.0",
    "@8thwall/xrextras": "1.0.0",
    "qrcode": "^1.5.4",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/extensions": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@types/node": "^22.10.0",
    "@types/three": "0.183.1",
    "draco3d": "^1.5.7",
    "jsqr": "^1.4.0",
    "playwright": "1.62.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  }
}
